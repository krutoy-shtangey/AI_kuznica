# Copy to /etc/reglament-ai/app.env (root:root, 0600).
# disabled, demo (synthetic only), or retrieval (after integration).
REGLAMENT_MODE=disabled
REGLAMENT_STATE_DIR=/var/lib/reglament-ai
AGENT_PER_MINUTE=12
AGENT_DAILY_ATTEMPTS=80
RETRIEVAL_INDEX=/var/lib/reglament-ai/index
RETRIEVAL_MODEL_ROOT=/var/lib/reglament-ai/models

# Configure the endpoint only for the intended data scope.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_CURRENCY=

QUALITY_ADMIN_SECRET=
QUALITY_ADMIN_NAME=quality-admin
PUBLIC_APP_URL=

SMTP_ENABLED=0
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
QUALITY_EMAIL=
