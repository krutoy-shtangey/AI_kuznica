LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30
# auto, json_schema, json_object, or prompt
LLM_JSON_MODE=json_object

# ProxyAPI basic text rates per million tokens. Check before use.
LLM_INPUT_PRICE_PER_MILLION=6.53
LLM_OUTPUT_PRICE_PER_MILLION=26.32
LLM_CURRENCY=RUB

# Independent comparison, not an Alibaba API request.
LLM_ALIBABA_INPUT_PRICE_PER_MILLION=1.468
LLM_ALIBABA_OUTPUT_PRICE_PER_MILLION=5.871
LLM_ALIBABA_CURRENCY=CNY
LLM_ALIBABA_REGION=Singapore (International)
LLM_ALIBABA_AS_OF=2026-11-26

# Administrative Bearer secret, at least 32 random characters. Leave empty to disable.
QUALITY_ADMIN_SECRET=
QUALITY_ADMIN_NAME=quality-admin

# Enable only for an authorized test mailbox. Use one of TLS (STARTTLS) or SSL.
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
QUALITY_EMAIL=
PUBLIC_APP_URL=
